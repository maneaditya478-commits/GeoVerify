# Application Configuration
APP_NAME="GeoVerify India"
APP_ENV=development
DEBUG=true

# Database Settings (PostGIS / PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/geoverify

# Geocoding Provider Settings
# Options: 'mock' (local reference catalog) or 'nominatim' (OpenStreetMap)
GEOCODER_PROVIDER=mock
GEOCODER_API_KEY=
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_RATE_LIMIT_DELAY=1.0

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Scoring Weights (Must sum to 100)
WEIGHT_HIERARCHY=25
WEIGHT_BOUNDARY=25
WEIGHT_LOCALITY=20
WEIGHT_PINCODE=15
WEIGHT_GEOCODING=10
WEIGHT_NEARBY=5

# Data Retention & Privacy
ANONYMIZE_LOGS=true
DATA_RETENTION_DAYS=30
